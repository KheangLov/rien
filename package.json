{
  "name": "rien",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "audit": "pnpm audit --audit-level high",
    "test": "vitest run",
    "typecheck": "nuxt typecheck",
    "build:ios": "RIEN_NATIVE=1 nuxt generate && cap sync ios",
    "open:ios": "cap open ios",
    "build:android": "RIEN_NATIVE=1 nuxt generate && cap sync android",
    "apk": "scripts/build-apk.sh",
    "apk:dev": "scripts/build-apk.sh --debug",
    "build:e2e": "RIEN_E2E=1 nuxt generate",
    "build:ios:e2e": "RIEN_NATIVE=1 RIEN_E2E=1 nuxt generate && cap sync ios",
    "install:iphone": "scripts/install-iphone.sh",
    "renew:iphone": "scripts/renew-iphone.sh",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@iconify-json/solar": "^1.2.13",
    "@vite-pwa/nuxt": "^1.1.1",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@squirkle-ui/calendar": "^0.1.2",
    "@squirkle-ui/charts": "^0.1.1",
    "@squirkle-ui/core": "^0.1.1",
    "@squirkle-ui/nuxt": "^0.1.1",
    "@squirkle-ui/ui": "^0.1.1",
    "dexie": "^4.4.7",
    "nuxt": "^4.6.2",
    "ts-fsrs": "5.4.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  }
