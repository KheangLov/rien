+// Rien patch: draw the SVG fallback as the same shape native CSS draws for
+// `border-radius: r * (1 + smoothing); corner-shape: squircle` (a superellipse,
+// |x|^4 + |y|^4 = 1, in each corner box), so Safari matches Chrome and Android.
+function superellipsePath(opts) {
+  const { width: w, height: h, smoothing = 0.6, offset = 0 } = opts;
+  if (w <= 0 || h <= 0) return "";
+  const radii = normalizeRadius(opts.radius);
+  const want = (r) => Math.max(0, r) * (1 + smoothing);
+  let sizes = [radii.topLeft, radii.topRight, radii.bottomRight, radii.bottomLeft].map(want);
+  // Like CSS: when neighbouring corners do not fit, scale them all down together.
+  const f = Math.min(1, w / (sizes[0] + sizes[1] || 1), w / (sizes[3] + sizes[2] || 1), h / (sizes[0] + sizes[3] || 1), h / (sizes[1] + sizes[2] || 1));
