+    let out = "";
+    for (let i = 1; i <= STEPS; i++) {
+      const t = (i / STEPS) * (Math.PI / 2);
+      const u = fromX ? Math.sqrt(Math.sin(t)) : Math.sqrt(Math.cos(t));
+      const v = fromX ? Math.sqrt(Math.cos(t)) : Math.sqrt(Math.sin(t));
+      out += ` L ${n(cx + dx * s * u)} ${n(cy + dy * s * v)}`;
+    }
+    return out;
+  };
