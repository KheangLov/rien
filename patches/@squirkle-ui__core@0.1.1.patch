+    corner(o + w - tr, o + tr, tr, 1, -1, true),
+    `L ${n(o + w)} ${n(o + h - br)}`,
+    corner(o + w - br, o + h - br, br, 1, 1, false),
+    `L ${n(o + bl)} ${n(o + h)}`,
+    corner(o + bl, o + h - bl, bl, -1, 1, true),
+    `L ${n(o)} ${n(o + tl)}`,
+    corner(o + tl, o + tl, tl, -1, -1, false),
+    "Z"
+  ].join(" ");
