@@ -310,6 +310,10 @@ function resolveIcon(icon) {
   if (name.startsWith("$")) {
     const key = name.slice(1);
     name = config.icons.aliases[key] ?? key;
+  } else if (config.icons.aliases[name]) {
+    // Rien patch: aliases also replace built-in names ("close", "search"), so an
